# Copy to deploy.env (gitignored) and fill in. Used by ./deploy.sh.

# Where to deploy (same as the SSH_USER / DEPLOYMENT_HOST GitHub variables).
SSH_USER=
DEPLOYMENT_HOST=

# Must match the password the existing Postgres volume was initialized with.
# Postgres only applies this when it creates the database for the first time.
POSTGRES_PASSWORD=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
DEFAULT_ADMINISTRATORS=

# Optional overrides:
# REMOTE_DIR=lister   # directory under the remote user's home
# HOST_PORT=8400      # host port the app is published on (see docker-compose.yml)
