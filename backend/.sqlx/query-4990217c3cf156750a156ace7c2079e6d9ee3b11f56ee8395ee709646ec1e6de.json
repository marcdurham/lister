{
  "db_name": "PostgreSQL",
  "query": "SELECT m.id, m.item_id, m.parent_id, m.position, m.visible, m.created_at, m.updated_at, m.deleted_at\n           FROM memberships m\n           JOIN items i ON i.id = m.item_id\n           WHERE m.updated_at > $1 AND i.owner_id = $2",
